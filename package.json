{
  "name": "mi-cultivo",
  "productName": "Mi Cultivo",
  "version": "1.1.0",
  "description": "Gestor personal de cultivo con invernadero 3D",
  "main": "main.js",
  "author": "Lucci",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:simple": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.lucci.micultivo",
    "productName": "Mi Cultivo",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  }
}